{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fontick",
  "version": "1.3.0",
  "identifier": "com.baotwo.fontick",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Fontick",
        "width": 420,
        "height": 720,
        "minWidth": 320,
        "minHeight": 520
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
